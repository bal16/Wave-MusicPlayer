{
  "workbench.colorCustomizations": {
    "minimap.background": "#00000000",
    "scrollbar.shadow": "#00000000"
  },
  // Single source of truth: [tool.ruff] in pyproject.toml.
  // These settings only point the editor at the project's own ruff.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Declutter Explorer: build artifacts, env, caches, local state.
  // __old/ intentionally stays visible (reference, per decision).
  "files.exclude": {
    "build/": true,
    "dist/": true,
    ".venv/": true,
    "**/__pycache__/": true,
    "**/*.pyc": true,
    ".pytest_cache/": true,
    ".ruff_cache/": true,
    "logs/": true,
    "data/": true,
    ".idea/": true
  },
  "search.exclude": {
    "build/": true,
    "dist/": true,
    ".venv/": true,
    "**/__pycache__/": true,
    ".pytest_cache/": true,
    ".ruff_cache/": true,
    "logs/": true,
    "data/": true,
    "__old/": true
  }
}
